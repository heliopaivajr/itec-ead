# ─── ITEC EAD — Variáveis de Ambiente ──────────────────────────────────────
# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA commite o arquivo .env — ele já está no .gitignore.

# Supabase — obtenha em: https://supabase.com/dashboard → Settings → API
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua_anon_key_aqui

# URL pública do site (sem barra final)
VITE_SITE_URL=https://www.itecedu.com

# ATENÇÃO: nunca use VITE_ para dados sensíveis de admin.
# Variáveis VITE_ são injetadas no bundle e visíveis no browser.
# Use roles no banco de dados (Supabase profiles.role) em vez disso.
# O role 'superadmin' é definido via migration SQL (20260525_004).
